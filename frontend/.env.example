# Kopieer naar .env.local om lokaal te ontwikkelen (npm run dev).
#
# Zonder deze regel praat de dev-server met zichzelf op localhost:5173, waar geen
# backend draait — het dashboard meldt dan 'verbinding kwijt'. In CI wordt deze
# waarde door de workflow gezet, niet door dit bestand.
VITE_API_BASE=https://mokum-streams-func.azurewebsites.net
