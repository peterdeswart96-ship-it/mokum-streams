# Dependencies — worden bij elke build opnieuw geïnstalleerd via npm install
node_modules/

# Build-output — wordt door de CI/CD-workflow gegenereerd, hoort niet in de repo
dist/
build/

# Logs
logs/
*.log
npm-debug.log*

# Environment-bestanden — kunnen secrets bevatten, NOOIT committen
.env
.env.*
!.env.example

# Azure Functions lokale instellingen — bevat connection strings en API-keys!
local.settings.json

# Deploy-stempel (#79) — hoort bij een deploy, niet bij de broncode.
# Wordt geschreven door `npm run stamp` en door de CI-workflow.
backend/src/deploy-info.json

# Agent lokale config — bevat OBS-wachtwoorden en agent-token, NOOIT committen
agent/agent-config.json

# Azure Functions build-artefacten
bin/
obj/

# Editor- en OS-rommel
.vscode/
.DS_Store
Thumbs.db

# Vite cache
.vite/

# Thumbnail-bron-achtergronden (AI-plaatjes + gekeyde overlays, ~22MB). De canonieke
# templates in assets/thumbnail-templates zijn zelfvoorzienend (bg als base64 ingebed),
# dus de runtime heeft deze bronnen niet nodig. Blijven lokaal om te kunnen herbouwen.
backend/assets/thumbnail-bg/

wiki/

# Lokale log van post-commit wiki-update hook
.claude/wiki-update.log
